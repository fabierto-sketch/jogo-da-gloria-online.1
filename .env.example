# Copie para ".env" para testar localmente. No Render, defina estas variáveis
# em: o seu Web Service > Environment.

# OBRIGATÓRIO — palavra-passe do painel de administração (/admin). Mínimo 6 caracteres.
ADMIN_PASSWORD=mude-esta-palavra-passe

# OBRIGATÓRIO EM PRODUÇÃO — ligação PostgreSQL (Neon, Render Postgres, Supabase…).
# Sem esta variável, o jogo usa um ficheiro SQLite local (só para testes no computador:
# no Render esse ficheiro apaga-se a cada reinício).
# DATABASE_URL=postgresql://utilizador:palavra-passe@servidor/base?sslmode=require

# SSL da base de dados: automático para Neon/Supabase/URL externa do Render.
# Force com true/false se necessário.
# DATABASE_SSL=true

# Porta local (o Render define PORT sozinho — não a crie lá).
PORT=3000

# Redirecionar HTTP para HTTPS (recomendado no Render).
FORCE_HTTPS=true

# Endereço público usado nos convites (opcional; detetado automaticamente).
# PUBLIC_URL=https://jogo-da-gloria-online.onrender.com

# --- Videochamada (WebRTC) -----------------------------------------------
# STUN gratuito já incluído. Para redes móveis (4G/5G) ou routers restritivos,
# configure um servidor TURN (ex.: Metered, Twilio, Cloudflare, Xirsys).
# TURN_URLS=turn:SERVIDOR:80,turn:SERVIDOR:443,turns:SERVIDOR:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302

# --- Opcionais --------------------------------------------------------------
# ADMIN_SESSION_HOURS=12
# MAX_ROOMS=200
# DATABASE_POOL_MAX=8
# SQLITE_FILE=./data/local.db
